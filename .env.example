# Generate real secrets with: python3 scripts/init_env.py
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_SECRET
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=mysql+pymysql://dms:REPLACE@db:3306/dms?charset=utf8mb4
DB_PASSWORD=REPLACE
DB_ROOT_PASSWORD=REPLACE
APP_PORT=8120
APP_BIND=0.0.0.0
# HTTP test instance only. Set true behind HTTPS in production.
COOKIE_SECURE=false
# Test only; restrict to hostnames/IP in production. Extra domains configurable in UI.
ALLOWED_HOSTS=*
MAX_UPLOAD_MB=50
# Local starting storage; SMB/NFS can subsequently be configured in the web UI.
DOCUMENTS_PATH=documents
# Scanner inbox mount, writable by UID/GID 10001. Keep separate from document originals.
CONSUME_PATH=/opt/dms-archiv/consume
# Shared secret for the private Codex service; never an OpenAI API key.
CODEX_SERVICE_TOKEN=REPLACE_WITH_RANDOM_64_CHAR_SECRET

# Maximum encrypted tenant backup size through the web UI (MB)
MAX_TENANT_BACKUP_MB=250

# Published image tag for both app and Codex. Pin a release or sha tag if needed.
IMAGE_TAG=latest

# Private NAS helper authentication. Generate >=32 random characters.
STORAGE_SERVICE_TOKEN=REPLACE_WITH_RANDOM_64_CHAR_SECRET
# Prepare this shared Linux bind mount once, before starting Compose. See README.
NAS_MOUNT_PATH=/srv/dms-system/nas
# Public scanner address (IP or hostname, no scheme). Can be changed in the UI.
SCANNER_PUBLIC_HOST=
SCANNER_BIND=0.0.0.0
SFTP_PORT=2222
FTP_PORT=2121
# Optional explicit IPv4 advertised by passive FTP, e.g. behind NAT.
# Otherwise the scanner address configured in the UI is used.
FTP_PASV_ADDRESS=

# Passive FTP data range, identical inside and outside bridge containers.
FTP_PASSIVE_MIN=30000
FTP_PASSIVE_MAX=30009
# Host-network override only: private loopback service ports.
CODEX_PORT=8001
STORAGE_PORT=8002
# Optional host-network evaluation DB, published on loopback only.
DB_PORT=3307
