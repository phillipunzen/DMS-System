# Generate real secrets with: python3 scripts/init_env.py
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_SECRET
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=mysql+pymysql://dms:REPLACE@db:3306/dms?charset=utf8mb4
DB_PASSWORD=REPLACE
DB_ROOT_PASSWORD=REPLACE
APP_PORT=8120
APP_BIND=0.0.0.0
# HTTP test instance only. Set true behind HTTPS in production.
COOKIE_SECURE=false
# Test only; restrict to hostnames/IP in production. Extra domains configurable in UI.
ALLOWED_HOSTS=*
MAX_UPLOAD_MB=50
# For NAS: pre-mounted host path with UID/GID 10001 write access.
DOCUMENTS_PATH=documents
# Scanner inbox mount, writable by UID/GID 10001. Keep separate from document originals.
CONSUME_PATH=/opt/dms-archiv/consume
# Shared secret for the private Codex service; never an OpenAI API key.
CODEX_SERVICE_TOKEN=REPLACE_WITH_RANDOM_64_CHAR_SECRET

# Maximum encrypted tenant backup size through the web UI (MB)
MAX_TENANT_BACKUP_MB=250

# Published image tag for both app and Codex. Pin a release or sha tag if needed.
IMAGE_TAG=latest
